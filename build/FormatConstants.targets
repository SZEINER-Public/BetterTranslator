<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <UsingTask TaskName="GenerateContainerFormat"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <HeaderPath ParameterType="System.String" Required="true" />
      <OutputPath ParameterType="System.String" Required="true" />
      <NamespaceName ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.Collections.Generic;
using System.IO;
using System.Text;
using System.Text.RegularExpressions;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

public class GenerateContainerFormat : Task
{
    public string HeaderPath { get; set; }
    public string OutputPath { get; set; }
    public string NamespaceName { get; set; }

    private static readonly Regex ConstantPattern = new Regex(
        @"^\s*inline\s+constexpr\s+(?<type>uint8_t|uint32_t|uint64_t)\s+(?<name>\w+)\s*=\s*(?<value>[^;]+);",
        RegexOptions.Compiled);

    private static readonly Regex StructPattern = new Regex(
        @"struct\s+(?<name>\w+)\s*\{(?<body>[^}]*)\}\s*;",
        RegexOptions.Compiled | RegexOptions.Singleline);

    private static readonly Regex FieldPattern = new Regex(
        @"(?<type>uint8_t|uint32_t|uint64_t)\s+(?<name>\w+)\s*(\[(?<length>\d+)\])?\s*;",
        RegexOptions.Compiled);

    public override bool Execute()
    {
        string header = File.ReadAllText(HeaderPath);
        var builder = new StringBuilder();

        builder.AppendLine("// <auto-generated/>");
        builder.AppendLine("#nullable enable");
        builder.AppendLine();
        builder.AppendLine("namespace " + NamespaceName + ";");
        builder.AppendLine();
        builder.AppendLine("internal static class BtPayFormat");
        builder.AppendLine("{");

        foreach (string line in header.Split('\n'))
        {
            Match constant = ConstantPattern.Match(line);
            if (!constant.Success)
            {
                continue;
            }

            builder.AppendLine("    public const " + MapType(constant.Groups["type"].Value) + " " +
                               MapName(constant.Groups["name"].Value) + " = " +
                               MapValue(constant.Groups["value"].Value.Trim()) + ";");
        }

        builder.AppendLine("}");

        int packStart = header.IndexOf("#pragma pack(push, 1)", StringComparison.Ordinal);
        int packEnd = header.IndexOf("#pragma pack(pop)", StringComparison.Ordinal);
        string packed = packStart >= 0 && packEnd > packStart
            ? header.Substring(packStart, packEnd - packStart)
            : string.Empty;

        foreach (Match structure in StructPattern.Matches(packed))
        {
            builder.AppendLine();
            builder.AppendLine("[System.Runtime.InteropServices.StructLayout(" +
                               "System.Runtime.InteropServices.LayoutKind.Sequential, Pack = 1)]");
            builder.AppendLine("internal unsafe struct " + structure.Groups["name"].Value);
            builder.AppendLine("{");

            foreach (Match field in FieldPattern.Matches(structure.Groups["body"].Value))
            {
                string type = MapType(field.Groups["type"].Value);
                string name = Pascal(field.Groups["name"].Value);
                string length = field.Groups["length"].Value;

                builder.AppendLine(length.Length == 0
                    ? "    public " + type + " " + name + ";"
                    : "    public fixed " + type + " " + name + "[" + length + "];");
            }

            builder.AppendLine("}");
        }

        string generated = builder.ToString().Replace("\r\n", "\n").Replace("\n", Environment.NewLine);
        string directory = Path.GetDirectoryName(OutputPath);
        if (!string.IsNullOrEmpty(directory))
        {
            Directory.CreateDirectory(directory);
        }

        if (!File.Exists(OutputPath) || File.ReadAllText(OutputPath) != generated)
        {
            File.WriteAllText(OutputPath, generated, new UTF8Encoding(false));
        }

        return true;
    }

    private static string MapType(string type)
    {
        if (type == "uint8_t") return "byte";
        if (type == "uint32_t") return "uint";
        return "ulong";
    }

    private static string MapName(string name)
    {
        if (name.Length > 1 && name[0] == 'k' && char.IsUpper(name[1]))
        {
            return name.Substring(1);
        }
        return Pascal(name);
    }

    private static string Pascal(string name)
    {
        if (name.Length == 0) return name;
        return char.ToUpperInvariant(name[0]) + name.Substring(1);
    }

    private static string MapValue(string value)
    {
        string trimmed = value.Trim();
        while (trimmed.Length > 0 && (trimmed.EndsWith("U", StringComparison.Ordinal) ||
                                      trimmed.EndsWith("L", StringComparison.Ordinal) ||
                                      trimmed.EndsWith("u", StringComparison.Ordinal) ||
                                      trimmed.EndsWith("l", StringComparison.Ordinal)))
        {
            trimmed = trimmed.Substring(0, trimmed.Length - 1);
        }
        return trimmed.Replace("'", string.Empty);
    }
}
]]></Code>
    </Task>
  </UsingTask>

  <PropertyGroup>
    <ContainerFormatHeader Condition="'$(ContainerFormatHeader)' == ''">$(MSBuildThisFileDirectory)..\native\BetterTranslator.Bootstrap\include\btpay_format.h</ContainerFormatHeader>
  </PropertyGroup>

  <Target Name="GenerateContainerFormatConstants" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <ContainerFormatGenerated Condition="'$(ContainerFormatGenerated)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(IntermediateOutputPath)BtPayFormat.g.cs'))</ContainerFormatGenerated>
    </PropertyGroup>
    <GenerateContainerFormat HeaderPath="$(ContainerFormatHeader)"
                             OutputPath="$(ContainerFormatGenerated)"
                             NamespaceName="$(RootNamespace)" />
    <ItemGroup>
      <Compile Include="$(ContainerFormatGenerated)" />
      <FileWrites Include="$(ContainerFormatGenerated)" />
    </ItemGroup>
  </Target>

</Project>
