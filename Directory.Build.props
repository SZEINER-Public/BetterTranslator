<Project>

  <PropertyGroup>
    <Version>1.0.6</Version>
    <Company>SZEINER s.r.o.</Company>
    <Product>BetterTranslator</Product>
    <Copyright>Copyright (c) 2026 SZEINER s.r.o.</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <BuildChannel Condition="'$(BuildChannel)' == ''">stable</BuildChannel>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RepositoryRootDirectory>$(MSBuildThisFileDirectory)</RepositoryRootDirectory>
    <RepositoryRootPath>$(MSBuildThisFileDirectory.TrimEnd('\'))</RepositoryRootPath>
  </PropertyGroup>

  <Target Name="ResolveBuildIdentity"
          BeforeTargets="GetAssemblyAttributes"
          Condition="'$(MSBuildProjectExtension)' == '.csproj'">

    <Exec Command="git -C &quot;$(RepositoryRootPath)&quot; rev-parse --short=7 HEAD"
          Condition="'$(BuildCommitSha)' == '' And Exists('$(RepositoryRootDirectory).git')"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low"
          EchoOff="true"
          IgnoreExitCode="true"
          ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDescribedCommit" />
    </Exec>

    <Exec Command="git -C &quot;$(RepositoryRootPath)&quot; log -1 --format=%25%25cI"
          Condition="'$(BuildTimestampUtc)' == '' And Exists('$(RepositoryRootDirectory).git')"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low"
          EchoOff="true"
          IgnoreExitCode="true"
          ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitDate" />
    </Exec>

    <PropertyGroup>
      <BuildCommitSha Condition="'$(BuildCommitSha)' == '' And '$(_GitDescribedCommit)' != ''">$([System.Text.RegularExpressions.Regex]::Match($(_GitDescribedCommit), '[0-9a-f]{7,40}').Value)</BuildCommitSha>
      <BuildCommitSha Condition="'$(BuildCommitSha)' == ''">0000000</BuildCommitSha>

      <BuildTimestampUtc Condition="'$(BuildTimestampUtc)' == '' And '$(_GitCommitDate)' != ''">$([System.Text.RegularExpressions.Regex]::Match($(_GitCommitDate), '[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+\-][0-9]{2}:[0-9]{2}').Value)</BuildTimestampUtc>

      <InformationalVersion>$(Version)+$(BuildCommitSha)</InformationalVersion>
    </PropertyGroup>

    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildChannel</_Parameter1>
        <_Parameter2>$(BuildChannel)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(BuildTimestampUtc)' != ''">
        <_Parameter1>BuildTimestampUtc</_Parameter1>
        <_Parameter2>$(BuildTimestampUtc)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
