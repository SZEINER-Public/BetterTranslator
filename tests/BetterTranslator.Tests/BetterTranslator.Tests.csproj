<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0-windows with WPF so the token dictionaries and the WPF-hosted
         map surface can be loaded and asserted against directly. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <DefineConstants Condition="'$(BtInstrument)' == 'true'">$(DefineConstants);BT_INSTRUMENT</DefineConstants>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- The parity fixtures: what the PowerShell reference actually answers,
         generated by tests\parity\<module>\oracle.ps1 and checked in so the
         default suite can compare without launching PowerShell. -->
    <None Include="Fixtures\TranslationAudit\*.md"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\Updates\*.json"
          Link="Fixtures\Updates\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\Runtime\*.json"
          Link="Fixtures\Runtime\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\Parallel\*.json"
          Link="Fixtures\Parallel\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\parity\**\*.json"
          Link="parity\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BetterTranslator.App\BetterTranslator.App.csproj" />
    <ProjectReference Include="..\..\src\BetterTranslator.Cli\BetterTranslator.Cli.csproj" />
    <ProjectReference Include="..\..\src\BetterTranslator.Core\BetterTranslator.Core.csproj" />
    <ProjectReference Include="..\..\src\BetterTranslator.Indexing\BetterTranslator.Indexing.csproj" />
    <ProjectReference Include="..\..\src\BetterTranslator.Map\BetterTranslator.Map.csproj" />
    <ProjectReference Include="..\..\src\BetterTranslator.Runtime\BetterTranslator.Runtime.csproj" />
    <ProjectReference Include="..\..\src\BetterTranslator.Updates\BetterTranslator.Updates.csproj" />
    <ProjectReference Include="..\..\src\BetterTranslator.Engine\BetterTranslator.Engine.csproj" />

    <ProjectReference Include="..\..\tools\BetterTranslator.Packer\BetterTranslator.Packer.csproj" />
  </ItemGroup>

</Project>
