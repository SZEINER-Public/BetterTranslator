<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:BetterTranslator.Mac.App.Controls"
             xmlns:vm="using:BetterTranslator.App.ViewModels"
             x:Class="BetterTranslator.Mac.App.Views.AddSourcesView"
             x:DataType="vm:AddSourcesViewModel">

    <Border Theme="{StaticResource DialogSurface}" Width="{StaticResource DialogWidthAddSources}">
        <StackPanel>

            <Grid Margin="20,18,14,0">
                <StackPanel>
                    <TextBlock Text="Add to this project" Theme="{StaticResource TextTitle}" />
                    <TextBlock Text="{Binding Subhead}"
                               Theme="{StaticResource TextProse}"
                               Foreground="{StaticResource BrushTextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,6,26,0" />
                </StackPanel>

                <controls:ChromeButton Icon="{StaticResource IconCloseSmall}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Command="{Binding CancelCommand}"
                                       ToolTip.Tip="Close"
                                       AutomationProperties.Name="Close" />
            </Grid>

            <StackPanel Margin="20,16,20,0">

                <Border Theme="{StaticResource SourceCard}"
                        controls:SelectableCard.TogglesSelection="True">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <CheckBox Grid.Column="0"
                                  Theme="{StaticResource AppCheckBox}"
                                  IsChecked="{Binding FolderSelected, Mode=TwoWay}"
                                  VerticalAlignment="Top"
                                  Margin="0,1,12,0"
                                  AutomationProperties.Name="A folder on this computer" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="A folder on this computer" Theme="{StaticResource TextCardTitle}" />
                            <TextBlock Text="{Binding FolderDetail}"
                                       Theme="{StaticResource TextMeta}"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Theme="{StaticResource LinkButton}"
                                Content="Choose..."
                                VerticalAlignment="Top"
                                Command="{Binding ChooseFolderCommand}"
                                AutomationProperties.Name="Choose a folder" />
                    </Grid>
                </Border>

                <Border Theme="{StaticResource SourceCard}"
                        controls:SelectableCard.TogglesSelection="True">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <CheckBox Grid.Column="0"
                                  Theme="{StaticResource AppCheckBox}"
                                  IsChecked="{Binding RepositorySelected, Mode=TwoWay}"
                                  VerticalAlignment="Top"
                                  Margin="0,1,12,0"
                                  AutomationProperties.Name="A code repository" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="A code repository" Theme="{StaticResource TextCardTitle}" />
                            <TextBlock Text="{Binding RepositoryDetail}"
                                       Theme="{StaticResource TextMeta}"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Theme="{StaticResource LinkButton}"
                                Content="Choose..."
                                VerticalAlignment="Top"
                                Command="{Binding ChooseRepositoryCommand}"
                                AutomationProperties.Name="Choose a repository" />
                    </Grid>
                </Border>

                <Border Theme="{StaticResource SourceCard}"
                        controls:SelectableCard.TogglesSelection="True">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <CheckBox Grid.Column="0"
                                  Theme="{StaticResource AppCheckBox}"
                                  IsChecked="{Binding FilesSelected, Mode=TwoWay}"
                                  VerticalAlignment="Top"
                                  Margin="0,1,12,0"
                                  AutomationProperties.Name="Individual files" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Individual files" Theme="{StaticResource TextCardTitle}" />
                            <TextBlock Text="{Binding FilesDetail}"
                                       Theme="{StaticResource TextMeta}"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Theme="{StaticResource LinkButton}"
                                Content="Pick..."
                                VerticalAlignment="Top"
                                Command="{Binding PickFilesCommand}"
                                AutomationProperties.Name="Pick files" />
                    </Grid>
                </Border>

                <Border Theme="{StaticResource SourceCard}"
                        IsEnabled="{Binding HasChats}"
                        controls:SelectableCard.TogglesSelection="True">
                    <Grid ColumnDefinitions="Auto,*" ToolTip.ShowOnDisabled="True">
                        <CheckBox Grid.Column="0"
                                  Theme="{StaticResource AppCheckBox}"
                                  IsChecked="{Binding AllChatsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Top"
                                  Margin="0,1,12,0"
                                  AutomationProperties.Name="Everything I have already translated" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Everything I have already translated" Theme="{StaticResource TextCardTitle}" />
                            <TextBlock Text="{Binding AllChatsDetail}"
                                       Theme="{StaticResource TextMeta}"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Theme="{StaticResource SourceCard}"
                        IsEnabled="{Binding HasChats}"
                        controls:SelectableCard.TogglesSelection="True">
                    <Grid ColumnDefinitions="Auto,*" ToolTip.ShowOnDisabled="True">
                        <CheckBox Grid.Column="0"
                                  Theme="{StaticResource AppCheckBox}"
                                  IsChecked="{Binding ChosenTermsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Top"
                                  Margin="0,1,12,0"
                                  AutomationProperties.Name="Only the words and sentences I choose" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Only the words and sentences I choose" Theme="{StaticResource TextCardTitle}" />
                            <TextBlock Text="{Binding ChosenTermsDetail}"
                                       Theme="{StaticResource TextMeta}"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <Border Background="{StaticResource BrushSurfaceSunken}"
                    BorderBrush="{StaticResource BrushBorderFaint}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11"
                    Padding="20,14,20,14"
                    Margin="0,10,0,0">
                <Grid>
                    <TextBlock Text="{Binding BlockedReason}"
                               Theme="{StaticResource TextMeta}"
                               Foreground="{StaticResource BrushTextMuted}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Theme="{StaticResource SecondaryButton}"
                                Content="Cancel"
                                Command="{Binding CancelCommand}"
                                AutomationProperties.Name="Cancel" />
                        <Button Theme="{StaticResource PrimaryButton}"
                                Content="{Binding ActionLabel}"
                                IsEnabled="{Binding CanStart}"
                                ToolTip.Tip="{Binding BlockedReason}"
                                Command="{Binding StartCommand}"
                                Margin="8,0,0,0"
                                AutomationProperties.Name="{Binding ActionLabel}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
