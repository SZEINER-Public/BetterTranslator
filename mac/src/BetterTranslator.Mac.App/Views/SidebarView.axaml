<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:BetterTranslator.Mac.App.Controls"
             xmlns:vm="using:BetterTranslator.App.ViewModels"
             x:Class="BetterTranslator.Mac.App.Views.SidebarView"
             x:DataType="vm:ChatWorkspaceViewModel"
             Background="{StaticResource BrushSurfaceMuted}">

    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12,0,12,0" Height="{StaticResource ChromeButtonSize}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="SweepHost" Grid.Column="0" Margin="0,0,8,0">
                <Button Theme="{StaticResource SecondaryButton}"
                        Command="{Binding NewChatCommand}"
                        HorizontalContentAlignment="Left"
                        Padding="10,0,10,0"
                        Height="{StaticResource ChromeButtonSize}"
                        AutomationProperties.Name="New chat">
                    <StackPanel Orientation="Horizontal">
                        <controls:IconView Definition="{StaticResource IconPlus}"
                                           VerticalAlignment="Center" />
                        <TextBlock Text="New chat"
                                   Theme="{StaticResource TextDefault}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                </Button>

                <Border x:Name="SearchSweep"
                        ClipToBounds="True"
                        HorizontalAlignment="Right"
                        Width="0"
                        Background="{StaticResource BrushSurfaceMuted}">
                    <Grid x:Name="SearchFieldHost" Width="{Binding #SweepHost.Bounds.Width}">
                        <TextBox x:Name="SearchField"
                                 Theme="{StaticResource TextField}"
                                 Height="{StaticResource ChromeButtonSize}"
                                 Padding="10,0,10,0"
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 AutomationProperties.Name="Search chats, words..."
                                 KeyDown="OnSearchKeyDown" />
                        <TextBlock Text="Search chats, words..."
                                   Theme="{StaticResource PlaceholderText}"
                                   Margin="11,0,0,0"
                                   IsVisible="{Binding SearchText, Converter={StaticResource StringEmptyToVisibility}}" />
                    </Grid>
                </Border>
            </Grid>

            <controls:ChromeButton x:Name="SearchToggle"
                                   Grid.Column="1"
                                   Icon="{StaticResource IconSearch}"
                                   Command="{Binding ToggleSearchCommand}"
                                   ToolTip.Tip="Search chats"
                                   AutomationProperties.Name="Search chats" />
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="No chats yet. Your first translation starts one."
                   Theme="{StaticResource TextSecondary}"
                   Foreground="{StaticResource BrushTextSecondary}"
                   TextWrapping="Wrap"
                   Margin="16,14,16,0"
                   IsVisible="{Binding !HasChats}" />

        <Grid Grid.Row="2"
              Margin="0,10,0,0"
              IsVisible="{Binding HasChats}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" IsVisible="{Binding HasPinned}">
                    <Button Theme="{StaticResource ToolbarChromeButton}"
                            Command="{Binding TogglePinnedSectionCommand}"
                            HorizontalContentAlignment="Left"
                            Margin="10,0,10,0"
                            AutomationProperties.Name="Pinned">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconView Definition="{StaticResource IconChevronDown}"
                                               Foreground="{StaticResource BrushTextTertiary}"
                                               VerticalAlignment="Center"
                                               RenderTransformOrigin="50%,50%" />
                            <TextBlock Text="PINNED"
                                       Theme="{StaticResource TextMeta}"
                                       Foreground="{StaticResource BrushTextTertiary}"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0" />
                            <TextBlock Text="{Binding PinnedCount}"
                                       Theme="{StaticResource TextMicro}"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"
                                       IsVisible="{Binding !IsPinnedSectionExpanded}" />
                        </StackPanel>
                    </Button>

                    <ListBox ItemsSource="{Binding PinnedView}"
                             SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                             Theme="{StaticResource ChatRowList}"
                             MaxHeight="{StaticResource PinnedSectionMaxHeight}"
                             IsVisible="{Binding IsPinnedSectionExpanded}" />
                </StackPanel>

                <Border BorderBrush="{StaticResource BrushBorderSoft}"
                        BorderThickness="0,1,0,0"
                        Margin="12,8,12,8"
                        Grid.Row="1"
                        IsVisible="{Binding HasPinned}" />

                <Button Grid.Row="2"
                        Theme="{StaticResource ToolbarChromeButton}"
                        Command="{Binding ToggleChatsSectionCommand}"
                        HorizontalContentAlignment="Left"
                        Margin="10,4,10,0"
                        AutomationProperties.Name="Chats">
                    <StackPanel Orientation="Horizontal">
                        <controls:IconView Definition="{StaticResource IconChevronDown}"
                                           Foreground="{StaticResource BrushTextTertiary}"
                                           VerticalAlignment="Center" />
                        <TextBlock Text="CHATS"
                                   Theme="{StaticResource TextMeta}"
                                   Foreground="{StaticResource BrushTextTertiary}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0" />
                        <TextBlock Text="{Binding ChatsCount}"
                                   Theme="{StaticResource TextMicro}"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"
                                   IsVisible="{Binding !IsChatsSectionExpanded}" />
                    </StackPanel>
                </Button>

                <ListBox Grid.Row="3"
                         ItemsSource="{Binding ChatsView}"
                         SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                         Theme="{StaticResource ChatRowList}"
                         IsVisible="{Binding IsChatsSectionExpanded}" />
        </Grid>
    </Grid>
</UserControl>
