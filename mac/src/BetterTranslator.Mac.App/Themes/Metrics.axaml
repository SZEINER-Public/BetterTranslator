    <sys:Double x:Key="PreviewMaxWidth">620</sys:Double>

    <sys:Double x:Key="ChromeButtonSize">32</sys:Double>
    <sys:Double x:Key="ChromeButtonSizeSmall">30</sys:Double>
    <sys:Double x:Key="ChipButtonSize">24</sys:Double>
    <sys:Double x:Key="ScopePathMaxWidth">240</sys:Double>
