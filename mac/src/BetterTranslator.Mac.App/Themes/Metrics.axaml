<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://BetterTranslator/Themes/Colors.axaml" />
    </ResourceDictionary.MergedDictionaries>

    <sys:Double x:Key="Space1">2</sys:Double>
    <sys:Double x:Key="Space2">4</sys:Double>
    <sys:Double x:Key="Space3">5</sys:Double>
    <sys:Double x:Key="Space4">6</sys:Double>
    <sys:Double x:Key="Space5">7</sys:Double>
    <sys:Double x:Key="Space6">8</sys:Double>
    <sys:Double x:Key="Space7">9</sys:Double>
    <sys:Double x:Key="Space8">10</sys:Double>
    <sys:Double x:Key="Space9">11</sys:Double>
    <sys:Double x:Key="Space10">12</sys:Double>
    <sys:Double x:Key="Space11">14</sys:Double>
    <sys:Double x:Key="Space12">16</sys:Double>
    <sys:Double x:Key="Space13">18</sys:Double>
    <sys:Double x:Key="Space14">20</sys:Double>
    <sys:Double x:Key="Space15">24</sys:Double>
    <sys:Double x:Key="Space16">28</sys:Double>

    <Thickness x:Key="Space1Thickness">2</Thickness>
    <Thickness x:Key="Space2Thickness">4</Thickness>
    <Thickness x:Key="Space3Thickness">5</Thickness>
    <Thickness x:Key="Space4Thickness">6</Thickness>
    <Thickness x:Key="Space5Thickness">7</Thickness>
    <Thickness x:Key="Space6Thickness">8</Thickness>
    <Thickness x:Key="Space7Thickness">9</Thickness>
    <Thickness x:Key="Space8Thickness">10</Thickness>
    <Thickness x:Key="Space9Thickness">11</Thickness>
    <Thickness x:Key="Space10Thickness">12</Thickness>
    <Thickness x:Key="Space11Thickness">14</Thickness>
    <Thickness x:Key="Space12Thickness">16</Thickness>
    <Thickness x:Key="Space13Thickness">18</Thickness>
    <Thickness x:Key="Space14Thickness">20</Thickness>
    <Thickness x:Key="Space15Thickness">24</Thickness>
    <Thickness x:Key="Space16Thickness">28</Thickness>

    <CornerRadius x:Key="RadiusXs">2</CornerRadius>
    <CornerRadius x:Key="RadiusSm">3</CornerRadius>
    <CornerRadius x:Key="RadiusMd">4</CornerRadius>
    <CornerRadius x:Key="RadiusControl">5</CornerRadius>
    <CornerRadius x:Key="RadiusDefault">6</CornerRadius>
    <CornerRadius x:Key="RadiusRow">7</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">8</CornerRadius>
    <CornerRadius x:Key="RadiusCard">9</CornerRadius>
    <CornerRadius x:Key="RadiusCardLg">10</CornerRadius>
    <CornerRadius x:Key="RadiusDialog">11</CornerRadius>
    <CornerRadius x:Key="RadiusComposer">22</CornerRadius>

    <sys:Double x:Key="BorderWidth">1</sys:Double>
    <sys:Double x:Key="BorderWidthControl">1.5</sys:Double>
    <Thickness x:Key="BorderThickness">1</Thickness>
    <Thickness x:Key="BorderThicknessControl">1.5</Thickness>

    <DropShadowDirectionEffect x:Key="ShadowWindow" Direction="270" BlurRadius="34" ShadowDepth="14" Opacity="0.18" Color="Black" />
    <DropShadowDirectionEffect x:Key="ShadowPopover" Direction="270" BlurRadius="26" ShadowDepth="10" Opacity="0.16" Color="Black" />
    <DropShadowDirectionEffect x:Key="ShadowDialog" Direction="270" BlurRadius="54" ShadowDepth="22" Opacity="0.24" Color="Black" />
    <DropShadowDirectionEffect x:Key="ShadowThumb" Direction="270" BlurRadius="2" ShadowDepth="1" Opacity="0.10" Color="Black" />

    <SplineEasing x:Key="EaseStandard" X1="0.2" Y1="0" X2="0" Y2="1" />
    <SplineEasing x:Key="EaseBurst" X1="0.3" Y1="0" X2="0.4" Y2="1" />

    <sys:TimeSpan x:Key="Motion120">0:0:0.12</sys:TimeSpan>
    <sys:TimeSpan x:Key="Motion130">0:0:0.13</sys:TimeSpan>
    <sys:TimeSpan x:Key="Motion140">0:0:0.14</sys:TimeSpan>
    <sys:TimeSpan x:Key="Motion150">0:0:0.15</sys:TimeSpan>
    <sys:TimeSpan x:Key="Motion160">0:0:0.16</sys:TimeSpan>
    <sys:TimeSpan x:Key="Motion170">0:0:0.17</sys:TimeSpan>
    <sys:TimeSpan x:Key="Motion180">0:0:0.18</sys:TimeSpan>
    <sys:TimeSpan x:Key="Motion200">0:0:0.2</sys:TimeSpan>
    <sys:TimeSpan x:Key="Motion220">0:0:0.22</sys:TimeSpan>
    <sys:TimeSpan x:Key="Motion240">0:0:0.24</sys:TimeSpan>
    <sys:TimeSpan x:Key="Motion300">0:0:0.3</sys:TimeSpan>
    <sys:TimeSpan x:Key="Motion320">0:0:0.32</sys:TimeSpan>
    <sys:TimeSpan x:Key="Motion400">0:0:0.4</sys:TimeSpan>
    <sys:TimeSpan x:Key="Motion900">0:0:0.9</sys:TimeSpan>
    <sys:TimeSpan x:Key="Motion1200">0:0:1.2</sys:TimeSpan>

    <sys:Double x:Key="SizePillHideDelayMs">400</sys:Double>
    <sys:Double x:Key="CopyConfirmHoldMs">1600</sys:Double>

    <sys:Double x:Key="SkeletonRevealDelayMs">150</sys:Double>
    <sys:Double x:Key="SkeletonMinHoldMs">350</sys:Double>

    <sys:Double x:Key="FocusRingWidth">2</sys:Double>
    <sys:Double x:Key="FocusRingOffset">2</sys:Double>

    <ControlTheme x:Key="FocusRing" TargetType="ContentControl">
        <Setter Property="Template">
            <ControlTemplate TargetType="ContentControl">
                <Rectangle Margin="-2"
                           RadiusX="{Binding TopLeft, Source={StaticResource RadiusMd}, x:CompileBindings=False}"
                           RadiusY="{Binding TopLeft, Source={StaticResource RadiusMd}, x:CompileBindings=False}"
                           Stroke="{StaticResource BrushAccent}"
                           StrokeThickness="{StaticResource FocusRingWidth}"
                           UseLayoutRounding="True" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <sys:Double x:Key="CaptionHeight">32</sys:Double>
    <sys:Double x:Key="ToolbarHeight">48</sys:Double>
    <sys:Double x:Key="WindowDefaultWidth">1536</sys:Double>
    <sys:Double x:Key="WindowDefaultHeight">1016</sys:Double>
    <sys:Double x:Key="WindowMinWidth">880</sys:Double>
    <sys:Double x:Key="WindowMinHeight">620</sys:Double>
