<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>BetterTranslator.Engine</AssemblyName>
    <RootNamespace>BetterTranslator.Engine</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <MirrorSourceRoot>$(WindowsSourceRoot)BetterTranslator.Engine\</MirrorSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MirrorSourceRoot)**\*.cs"
             Exclude="$(MirrorSourceRoot)bin\**\*.cs;$(MirrorSourceRoot)obj\**\*.cs"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(MirrorSourceRoot)Data\languages.json" LogicalName="BetterTranslator.Engine.Data.languages.json" />
    <EmbeddedResource Include="$(MirrorSourceRoot)Data\language-assets.json" LogicalName="BetterTranslator.Engine.Data.language-assets.json" />
    <EmbeddedResource Include="$(MirrorSourceRoot)Data\model-languages.json" LogicalName="BetterTranslator.Engine.Data.model-languages.json" />
    <EmbeddedResource Include="$(MirrorSourceRoot)Data\model-prompts.json" LogicalName="BetterTranslator.Engine.Data.model-prompts.json" />
    <EmbeddedResource Include="$(MirrorSourceRoot)Data\prompts.json" LogicalName="BetterTranslator.Engine.Data.prompts.json" />
    <EmbeddedResource Include="$(MirrorSourceRoot)Data\rag.defaults.json" LogicalName="BetterTranslator.Engine.Data.rag.defaults.json" />
    <EmbeddedResource Include="$(MirrorSourceRoot)Data\glossary-cs.md" LogicalName="BetterTranslator.Engine.Data.glossary-cs.md" />
    <EmbeddedResource Include="$(MirrorSourceRoot)Data\domain-terms-cs.md" LogicalName="BetterTranslator.Engine.Data.domain-terms-cs.md" />
    <EmbeddedResource Include="$(MirrorSourceRoot)Data\rules-cs.md" LogicalName="BetterTranslator.Engine.Data.rules-cs.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="WeCantSpell.Hunspell" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BetterTranslator.Core.Mirror\BetterTranslator.Core.Mirror.csproj" />
  </ItemGroup>

</Project>
