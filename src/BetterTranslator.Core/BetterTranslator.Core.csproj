<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <DefineConstants Condition="'$(BtInstrument)' == 'true'">$(DefineConstants);BT_INSTRUMENT</DefineConstants>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Verification\Checks\Ratio\ratio-profile.json" LogicalName="BetterTranslator.Core.Verification.Checks.Ratio.ratio-profile.json" />
    <EmbeddedResource Include="Verification\Checks\Coverage\language-seeds.json" LogicalName="BetterTranslator.Core.Verification.Checks.Coverage.language-seeds.json" />
    <EmbeddedResource Include="Verification\Checks\Naturalness\Packs\nat-cs.json" LogicalName="BetterTranslator.Core.Verification.Checks.Naturalness.Packs.nat-cs.json" />
    <EmbeddedResource Include="Verification\Checks\Naturalness\Packs\nat-sk.json" LogicalName="BetterTranslator.Core.Verification.Checks.Naturalness.Packs.nat-sk.json" />
    <EmbeddedResource Include="Verification\Checks\Naturalness\coverage-matrix.json" LogicalName="BetterTranslator.Core.Verification.Checks.Naturalness.coverage-matrix.json" />
    <EmbeddedResource Include="Verification\Checks\Naturalness\naturalness-profile.json" LogicalName="BetterTranslator.Core.Verification.Checks.Naturalness.naturalness-profile.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
    <!-- Microsoft.Data.Sqlite pulls e_sqlite3 2.1.11 transitively, which
         carries advisory GHSA-2m69-gcr7-jv3q. Pinned forward to the patched
         build; this is version management of an existing transitive
         dependency, not a new one. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>

</Project>
