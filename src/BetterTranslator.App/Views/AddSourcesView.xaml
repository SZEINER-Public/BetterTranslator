<UserControl x:Class="BetterTranslator.App.Views.AddSourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BetterTranslator.App.Controls">

    <Border Style="{StaticResource DialogSurface}" Width="{StaticResource DialogWidthAddSources}">
        <StackPanel>

            <Grid Margin="20,18,14,0">
                <StackPanel>
                    <TextBlock Text="Add to this project" Style="{StaticResource TextTitle}" />
                    <TextBlock Text="{Binding Subhead}"
                               Style="{StaticResource TextProse}"
                               Foreground="{StaticResource BrushTextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,6,26,0" />
                </StackPanel>

                <controls:ChromeButton Icon="{StaticResource IconCloseSmall}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Command="{Binding CancelCommand}"
                                       ToolTip="Close"
                                       AutomationProperties.Name="Close" />
            </Grid>

            <StackPanel Margin="20,16,20,0">

                <!-- 1. A folder on this computer -->
                <Border Style="{StaticResource SourceCard}"
                        controls:SelectableCard.TogglesSelection="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  Style="{StaticResource AppCheckBox}"
                                  IsChecked="{Binding FolderSelected, Mode=TwoWay}"
                                  VerticalAlignment="Top"
                                  Margin="0,1,12,0"
                                  AutomationProperties.Name="A folder on this computer" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="A folder on this computer" Style="{StaticResource TextCardTitle}" />
                            <TextBlock Text="{Binding FolderDetail}"
                                       Style="{StaticResource TextMeta}"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Style="{StaticResource LinkButton}"
                                Content="Choose..."
                                VerticalAlignment="Top"
                                Command="{Binding ChooseFolderCommand}"
                                AutomationProperties.Name="Choose a folder" />
                    </Grid>
                </Border>

                <!-- 2. A code repository -->
                <Border Style="{StaticResource SourceCard}"
                        controls:SelectableCard.TogglesSelection="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  Style="{StaticResource AppCheckBox}"
                                  IsChecked="{Binding RepositorySelected, Mode=TwoWay}"
                                  VerticalAlignment="Top"
                                  Margin="0,1,12,0"
                                  AutomationProperties.Name="A code repository" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="A code repository" Style="{StaticResource TextCardTitle}" />
                            <TextBlock Text="{Binding RepositoryDetail}"
                                       Style="{StaticResource TextMeta}"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Style="{StaticResource LinkButton}"
                                Content="Choose..."
                                VerticalAlignment="Top"
                                Command="{Binding ChooseRepositoryCommand}"
                                AutomationProperties.Name="Choose a repository" />
                    </Grid>
                </Border>

                <!-- 3. Individual files -->
                <Border Style="{StaticResource SourceCard}"
                        controls:SelectableCard.TogglesSelection="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  Style="{StaticResource AppCheckBox}"
                                  IsChecked="{Binding FilesSelected, Mode=TwoWay}"
                                  VerticalAlignment="Top"
                                  Margin="0,1,12,0"
                                  AutomationProperties.Name="Individual files" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Individual files" Style="{StaticResource TextCardTitle}" />
                            <TextBlock Text="{Binding FilesDetail}"
                                       Style="{StaticResource TextMeta}"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Style="{StaticResource LinkButton}"
                                Content="Pick..."
                                VerticalAlignment="Top"
                                Command="{Binding PickFilesCommand}"
                                AutomationProperties.Name="Pick files" />
                    </Grid>
                </Border>

                <!-- 4. Everything I have already translated. Gated on a chat
                     existing, and the row says why. -->
                <Border Style="{StaticResource SourceCard}"
                        IsEnabled="{Binding HasChats}"
                        controls:SelectableCard.TogglesSelection="True">
                    <Grid ToolTipService.ShowOnDisabled="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  Style="{StaticResource AppCheckBox}"
                                  IsChecked="{Binding AllChatsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Top"
                                  Margin="0,1,12,0"
                                  AutomationProperties.Name="Everything I have already translated" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Everything I have already translated" Style="{StaticResource TextCardTitle}" />
                            <TextBlock Text="{Binding AllChatsDetail}"
                                       Style="{StaticResource TextMeta}"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 5. Only the words and sentences I choose, gated the same way -->
                <Border Style="{StaticResource SourceCard}"
                        IsEnabled="{Binding HasChats}"
                        controls:SelectableCard.TogglesSelection="True">
                    <Grid ToolTipService.ShowOnDisabled="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  Style="{StaticResource AppCheckBox}"
                                  IsChecked="{Binding ChosenTermsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Top"
                                  Margin="0,1,12,0"
                                  AutomationProperties.Name="Only the words and sentences I choose" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Only the words and sentences I choose" Style="{StaticResource TextCardTitle}" />
                            <TextBlock Text="{Binding ChosenTermsDetail}"
                                       Style="{StaticResource TextMeta}"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <Border Background="{StaticResource BrushSurfaceSunken}"
                    BorderBrush="{StaticResource BrushBorderFaint}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11"
                    Padding="20,14,20,14"
                    Margin="0,10,0,0">
                <Grid>
                    <TextBlock Text="{Binding BlockedReason}"
                               Style="{StaticResource TextMeta}"
                               Foreground="{StaticResource BrushTextMuted}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}"
                                Content="Cancel"
                                Command="{Binding CancelCommand}"
                                AutomationProperties.Name="Cancel" />
                        <Button Style="{StaticResource PrimaryButton}"
                                Content="{Binding ActionLabel}"
                                IsEnabled="{Binding CanStart}"
                                ToolTip="{Binding BlockedReason}"
                                Command="{Binding StartCommand}"
                                Margin="8,0,0,0"
                                AutomationProperties.Name="{Binding ActionLabel}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
