<UserControl x:Class="BetterTranslator.App.Views.FirstRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BetterTranslator.App.Controls">

    <Border Style="{StaticResource DialogSurface}" Width="520">
        <StackPanel>

            <!-- Header, wordmark and stage title, with the way out on the right -->
            <Grid Margin="20,18,20,0">
                <StackPanel Orientation="Horizontal">
                    <controls:Wordmark BarBrush="{StaticResource BrushText}"
                                       AccentBrush="{StaticResource BrushAccent}"
                                       MarkHeight="11"
                                       VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource TextTitle}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Hidden while installing: closing midway would leave a part
                     downloaded model behind with nothing tracking it. -->
                <controls:ChromeButton Icon="{StaticResource IconCloseCrossSearch}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Command="{Binding DismissCommand}"
                                       ToolTip="Close without installing"
                                       AutomationProperties.Name="Close without installing"
                                       Visibility="{Binding IsChoosing, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- ============ stage 1: what to install ============ -->
            <StackPanel Visibility="{Binding IsChoosing, Converter={StaticResource BoolToVisibility}}">

                <!-- Where it goes -->
                <StackPanel Orientation="Horizontal" Margin="20,16,20,0">
                    <Border Background="{StaticResource BrushTrack}"
                            CornerRadius="{StaticResource RadiusPanel}"
                            Padding="{StaticResource Space1Thickness}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource FolderSegment}"
                                         Content="Default folder"
                                         IsChecked="{Binding IsUsingDefaultFolder, Mode=OneWay}"
                                         Command="{Binding UseDefaultFolderCommand}"
                                         AutomationProperties.Name="Default folder" />
                            <RadioButton Style="{StaticResource FolderSegment}"
                                         Content="Pick a folder"
                                         Command="{Binding PickFolderCommand}"
                                         AutomationProperties.Name="Pick a folder" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="20,10,20,0">
                    <TextBlock Text="{Binding PathLabel}"
                               Style="{StaticResource TextMeta}"
                               Foreground="{StaticResource BrushTextTertiary}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ChosenPath}"
                               Style="{StaticResource TextMonoPath}"
                               Foreground="{StaticResource BrushTextSubtle}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="360"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="What to install"
                           Style="{StaticResource TextSubheading}"
                           Margin="20,18,20,8" />

                <ItemsControl ItemsSource="{Binding Items}" Margin="20,0,20,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- The whole card is the target, not just the box
                                 in its corner. A CheckBox templated down to its
                                 content carries the hit area, the focus, the
                                 space bar and the automation name; the card is
                                 what it draws, and the box inside is an
                                 indicator that no longer takes clicks of its
                                 own, so one press cannot toggle twice. -->
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      IsEnabled="{Binding CanDeselect}"
                                      AutomationProperties.Name="{Binding Name}"
                                      HorizontalContentAlignment="Stretch"
                                      Cursor="Hand">
                                <CheckBox.Template>
                                    <ControlTemplate TargetType="CheckBox">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </CheckBox.Template>
                            <Border>
                                <Border.Style>
                                    <!-- C8: a selected card takes the soft tint
                                         and the accent border. -->
                                    <Style TargetType="Border" BasedOn="{StaticResource SourceCard}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrushAccentTintSoft}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushAccentBorder}" />
                                            </DataTrigger>

                                            <!-- Nothing to fetch, so the row steps back:
                                                 sunken rather than raised, and dimmed. It
                                                 stays legible and still tickable, because a
                                                 reader may want to re-download a copy they
                                                 suspect is wrong. -->
                                            <DataTrigger Binding="{Binding IsInstalledHere}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrushSurfaceSunken}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderFaint}" />
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTextMuted}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Greyed and unclickable once the file is at
                                         the destination: there is no "off" for
                                         something already sitting there. -->
                                    <CheckBox Grid.Column="0"
                                              Style="{StaticResource AppCheckBox}"
                                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              IsEnabled="{Binding CanDeselect}"
                                              IsHitTestVisible="False"
                                              Focusable="False"
                                              VerticalAlignment="Top"
                                              Margin="0,1,12,0"
                                              ToolTip="{Binding Name}"
                                              AutomationProperties.Name="{Binding Name}" />

                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource TextCardTitle}"
                                                       VerticalAlignment="Center" />
                                            <Border Background="{StaticResource BrushAccentTint}"
                                                    CornerRadius="{StaticResource RadiusSm}"
                                                    Padding="6,1,6,2"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding HasTag, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding Tag}"
                                                           Style="{StaticResource TextMicro}"
                                                           Foreground="{StaticResource BrushAccentDeep}" />
                                            </Border>

                                            <!-- Already on the machine. The box beside it is
                                                 ticked, which says the state; this mark is the
                                                 "why", and hovering gives the folder. Not a
                                                 warning, because nothing is wrong, and not a
                                                 tick, which would repeat the checkbox.

                                                 Wrapped in a Border with a transparent
                                                 background because an icon is strokes over
                                                 nothing: with no filled area to hit-test, the
                                                 pointer falls straight through and the
                                                 tooltip never opens. -->
                                            <Border Background="Transparent"
                                                    Margin="8,0,0,0"
                                                    Padding="2"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.InitialShowDelay="150"
                                                    ToolTipService.ShowDuration="20000"
                                                    ToolTip="{Binding PresenceNote}"
                                                    AutomationProperties.Name="{Binding PresenceNote}"
                                                    Visibility="{Binding HasPresenceNote, Converter={StaticResource BoolToVisibility}}">
                                                <controls:IconView Definition="{StaticResource IconInfoCircle}"
                                                                   Foreground="{StaticResource BrushAccentDeep}"
                                                                   Width="14"
                                                                   Height="14"
                                                                   IsHitTestVisible="False" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Summary}"
                                                   Style="{StaticResource TextMeta}"
                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />

                                        <!-- A flavour this machine cannot run is
                                             shown and locked rather than hidden,
                                             so the list says what exists and why
                                             it is unavailable. Muted and in the
                                             same words the Runtime card uses. -->
                                        <TextBlock Text="{Binding BlockedReason}"
                                                   Style="{StaticResource TextMeta}"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   Visibility="{Binding HasBlockedReason, Converter={StaticResource BoolToVisibility}}" />

                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding SizeLabel}"
                                               Style="{StaticResource TextSecondary}"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0" />

                                    <controls:ChromeButton Grid.Column="3"
                                                           Icon="{StaticResource IconCloseSmall}"
                                                           Width="{StaticResource Space16}"
                                                           Height="{StaticResource Space16}"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center"
                                                           ToolTip="Remove this model"
                                                           AutomationProperties.Name="Remove this model"
                                                           Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}"
                                                           Command="{Binding DataContext.RemoveCustomModelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Another model from the web -->
                <Border BorderBrush="{StaticResource BrushBorderSoft}"
                        BorderThickness="{StaticResource BorderThickness}"
                        CornerRadius="{StaticResource RadiusCard}"
                        Background="{StaticResource BrushSurfaceSunken}"
                        Padding="14,12,14,12"
                        Margin="20,4,20,0">
                    <StackPanel>
                        <TextBlock Text="Another model from the web" Style="{StaticResource TextCardTitle}" />
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox Style="{StaticResource TextField}"
                                         Text="{Binding CustomModelLink, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Link to a model" />
                                <TextBlock Text="huggingface.co/owner/model or https://.../model.gguf"
                                           Style="{StaticResource PlaceholderText}"
                                           Margin="10,0,0,0"
                                           Visibility="{Binding CustomModelLink, Converter={StaticResource StringEmptyToVisibility}}" />
                            </Grid>
                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Add"
                                    Margin="8,0,0,0"
                                    Command="{Binding AddCustomModelCommand}"
                                    AutomationProperties.Name="Add this model" />
                        </Grid>
                        <TextBlock Text="{Binding LinkRejection}"
                                   Style="{StaticResource TextMeta}"
                                   Foreground="{StaticResource BrushDangerText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding LinkRejection, Converter={StaticResource NotEmptyToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Footer -->
                <Border Background="{StaticResource BrushSurfaceSunken}"
                        BorderBrush="{StaticResource BrushBorderFaint}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,11,11"
                        Padding="20,14,20,14"
                        Margin="0,18,0,0">
                    <Grid>
                        <TextBlock Style="{StaticResource TextMeta}"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Text="{Binding DownloadSizeLabel}"
                                   Visibility="{Binding DownloadSizeLabel, Converter={StaticResource NotEmptyToVisibility}}" />
                        <TextBlock Style="{StaticResource TextMeta}"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   TextWrapping="Wrap"
                                   MaxWidth="300"
                                   Text="{Binding InstallBlockedReason}"
                                   Visibility="{Binding CanInstall, Converter={StaticResource InverseBoolToVisibility}}" />

                        <!-- Installing only a runtime is allowed. Saying what it
                             leaves you with is not a warning, it is the sentence
                             that stops the first translation being a surprise. -->
                        <TextBlock Style="{StaticResource TextMeta}"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   TextWrapping="Wrap"
                                   MaxWidth="300"
                                   Text="{Binding NoModelNote}"
                                   Visibility="{Binding NoModelNote, Converter={StaticResource NotEmptyToVisibility}}" />

                        <Button Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right"
                                Content="{Binding InstallLabel}"
                                IsEnabled="{Binding CanInstall}"
                                ToolTip="{Binding InstallBlockedReason}"
                                Command="{Binding InstallCommand}" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ============ stage 2: installing ============ -->
            <StackPanel Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Items}" Margin="20,16,20,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,14"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="{StaticResource Space6}"
                                                 Height="{StaticResource Space6}"
                                                 VerticalAlignment="Center"
                                                 Fill="{StaticResource BrushWarn}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource BrushSuccess}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource TextDefault}"
                                                   Margin="9,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Success strings take the deep value; the
                                         fill value never carries text. -->
                                    <TextBlock Text="{Binding StatusLabel}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextSecondary}">
                                                <Setter Property="Foreground" Value="{StaticResource BrushAccentDeep}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushSuccessDeep}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <ProgressBar Style="{StaticResource AppProgressBar}"
                                             Value="{Binding Percent}"
                                             Margin="0,8,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="{StaticResource BrushSurfaceSunken}"
                        BorderBrush="{StaticResource BrushBorderFaint}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,11,11"
                        Padding="20,13,20,13"
                        Margin="0,6,0,0">
                    <TextBlock Text="{Binding FooterStatus}"
                               Style="{StaticResource TextFine}"
                               Foreground="{StaticResource BrushTextSubtle}"
                               TextTrimming="CharacterEllipsis" />
                </Border>
            </StackPanel>

            <!-- ============ stage 3: where to start ============ -->
            <StackPanel Visibility="{Binding IsChoosingStart, Converter={StaticResource BoolToVisibility}}">
                <UniformGrid Rows="1" Margin="20,18,20,0">
                    <Button Style="{StaticResource StartTile}"
                            Command="{Binding StartCommand}"
                            CommandParameter="JustChat"
                            AutomationProperties.Name="Just chat">
                        <StackPanel>
                            <Border Background="{StaticResource BrushAccentTint}"
                                    CornerRadius="{StaticResource RadiusCardLg}"
                                    Width="{StaticResource Space16}"
                                    Height="{StaticResource Space16}"
                                    HorizontalAlignment="Center">
                                <controls:IconView Definition="{StaticResource IconChatBubbleLarge}"
                                                   Foreground="{StaticResource BrushAccent}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Just chat"
                                       Style="{StaticResource TextCardTitle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Locked, because both tiles lead to a project scope and
                         that scope is locked. Left in place rather than removed:
                         a first run that offers one card says less about what
                         the app is for than three with two of them padlocked. -->
                    <Button Style="{StaticResource StartTile}"
                            Command="{Binding StartCommand}"
                            CommandParameter="Repository"
                            IsEnabled="False"
                            ToolTip="Repository is coming soon"
                            ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="Repository. Repository is coming soon">
                        <StackPanel>
                            <Border Background="{StaticResource BrushAccentTint}"
                                    CornerRadius="{StaticResource RadiusCardLg}"
                                    Width="{StaticResource Space16}"
                                    Height="{StaticResource Space16}"
                                    HorizontalAlignment="Center">
                                <controls:IconView Definition="{StaticResource IconRepository}"
                                                   Foreground="{StaticResource BrushAccent}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,12,0,0">
                                <controls:IconView Definition="{StaticResource IconLockSegment}"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                                <TextBlock Text="Repository"
                                           Style="{StaticResource TextCardTitle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource StartTile}"
                            Command="{Binding StartCommand}"
                            CommandParameter="Folder"
                            IsEnabled="False"
                            ToolTip="Folder is coming soon"
                            ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="Folder. Folder is coming soon">
                        <StackPanel>
                            <Border Background="{StaticResource BrushAccentTint}"
                                    CornerRadius="{StaticResource RadiusCardLg}"
                                    Width="{StaticResource Space16}"
                                    Height="{StaticResource Space16}"
                                    HorizontalAlignment="Center">
                                <controls:IconView Definition="{StaticResource IconFolderLarge}"
                                                   Foreground="{StaticResource BrushAccent}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,12,0,0">
                                <controls:IconView Definition="{StaticResource IconLockSegment}"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                                <TextBlock Text="Folder"
                                           Style="{StaticResource TextCardTitle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <Border Background="{StaticResource BrushSurfaceSunken}"
                        BorderBrush="{StaticResource BrushBorderFaint}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,11,11"
                        Padding="20,13,20,13"
                        Margin="0,18,0,0">
                    <TextBlock Text="You can change this later"
                               Style="{StaticResource TextMeta}"
                               Foreground="{StaticResource BrushTextMuted}" />
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
