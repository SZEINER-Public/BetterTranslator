<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:json="clr-namespace:BetterTranslator.Engine.Json;assembly=BetterTranslator.Engine">

    <!-- A resource file read as what it is: keys against values. The key path is
         flattened rather than indented, because that is how a key is written at
         the call site and how a translator searches for one.

         Monospaced throughout, and the two sides are told apart by colour rather
         than by a rule between them: a key is muted and never changes, a
         translatable value is full strength, and a number, a boolean or a null
         is muted again because nothing will happen to it. -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/BetterTranslator;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="pack://application:,,,/BetterTranslator;component/Themes/Typography.xaml" />
        <ResourceDictionary Source="pack://application:,,,/BetterTranslator;component/Themes/Metrics.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate DataType="{x:Type json:JsonScalar}">
        <Grid Margin="0,0,0,3">
            <Grid.ColumnDefinitions>
                <!-- The key column takes what it needs and stops; a long path
                     wraps rather than pushing the value off the pane. -->
                <ColumnDefinition Width="Auto" SharedSizeGroup="JsonKey" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding KeyPath}"
                       Style="{StaticResource TextMonoSmall}"
                       Foreground="{StaticResource BrushTextSubtle}"
                       TextWrapping="Wrap"
                       Margin="0,0,14,0"
                       MaxWidth="{StaticResource ScopePathMaxWidth}" />

            <TextBlock x:Name="Value"
                       Grid.Column="1"
                       Text="{Binding Text}"
                       Style="{StaticResource TextMonoPath}"
                       TextWrapping="Wrap" />
        </Grid>

        <DataTemplate.Triggers>
            <!-- Not a string, so nothing here will be translated and the row is
                 shown as context rather than as content. -->
            <DataTrigger Binding="{Binding IsString}" Value="False">
                <Setter TargetName="Value" Property="Foreground" Value="{StaticResource BrushTextTertiary}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Shared sizing so the key column lines up down the whole document, and
         the value column starts in the same place on every row. -->
    <Style x:Key="JsonRows" TargetType="ItemsControl">
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
    </Style>

</ResourceDictionary>
